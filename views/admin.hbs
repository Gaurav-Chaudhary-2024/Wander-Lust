<div class="container" style="padding: 4rem 1rem; min-height: 70vh;">
  <button class="back-btn" onclick="window.location.href='/'">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    Back to Home
  </button>

  <div style="text-align: center; margin-bottom: 3rem;">
    <h1 style="font-size: 2.5rem; color: var(--primary); margin-bottom: 0.5rem;">Admin Dashboard</h1>
    <p style="color: var(--muted-foreground);">Manage bookings and site administration</p>
  </div>
  
  <div style="max-width: 1400px; margin: 0 auto;">
    <!-- Stats Section -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
      <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3 style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-transform: uppercase;">Total Bookings</h3>
        <p style="font-size: 2rem; font-weight: bold; color: var(--primary); margin: 0;" id="statTotalBookings">{{stats.totalBookings}}</p>
      </div>
      <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3 style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-transform: uppercase;">Pending</h3>
        <p style="font-size: 2rem; font-weight: bold; color: #f59e0b; margin: 0;" id="statPendingBookings">{{stats.pendingBookings}}</p>
      </div>
      <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3 style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-transform: uppercase;">Approved</h3>
        <p style="font-size: 2rem; font-weight: bold; color: #10b981; margin: 0;" id="statApprovedBookings">{{stats.approvedBookings}}</p>
      </div>
      <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3 style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-transform: uppercase;">Rejected</h3>
        <p style="font-size: 2rem; font-weight: bold; color: #ef4444; margin: 0;" id="statRejectedBookings">{{stats.rejectedBookings}}</p>
      </div>
      <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3 style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-transform: uppercase;">Total Users</h3>
        <p style="font-size: 2rem; font-weight: bold; color: var(--primary); margin: 0;" id="statTotalUsers">{{stats.totalUsers}}</p>
      </div>
      <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3 style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-transform: uppercase;">Pending Payments</h3>
        <p style="font-size: 2rem; font-weight: bold; color: #f59e0b; margin: 0;" id="statPendingPayments">{{stats.pendingPayments}}</p>
      </div>
    </div>

    <!-- Filters Section -->
    <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); margin-bottom: 2rem;">
      <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <label style="font-weight: 500;">Filter by Status:</label>
        <select id="statusFilter" style="padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: 4px; background: var(--background); color: var(--foreground);">
          <option value="">All Bookings</option>
          <option value="pending">Pending</option>
          <option value="approved">Approved</option>
          <option value="rejected">Rejected</option>
          <option value="cancelled">Cancelled</option>
          <option value="completed">Completed</option>
        </select>
        <button onclick="loadBookings()" class="btn btn-primary" style="padding: 0.5rem 1.5rem;">Refresh</button>
      </div>
    </div>

    <!-- Tabs for Bookings and Payments -->
    <div style="background: var(--card); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); margin-bottom: 2rem;">
      <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 2px solid var(--border);">
        <button onclick="showBookingsTab()" id="bookingsTabBtn" class="tab-btn active" style="padding: 0.75rem 1.5rem; background: var(--primary); color: white; border: none; border-radius: 4px 4px 0 0; cursor: pointer; font-weight: 600;">
          Bookings
        </button>
        <button onclick="showPaymentsTab()" id="paymentsTabBtn" class="tab-btn" style="padding: 0.75rem 1.5rem; background: transparent; color: var(--muted-foreground); border: none; cursor: pointer; font-weight: 600;">
          Payments
        </button>
        <button onclick="showTestimonialsTab()" id="testimonialsTabBtn" class="tab-btn" style="padding: 0.75rem 1.5rem; background: transparent; color: var(--muted-foreground); border: none; cursor: pointer; font-weight: 600;">
          Testimonials
        </button>
      </div>

      <!-- Bookings Table -->
      <div id="bookingsTab" style="display: block;">
        <h2 style="font-size: 1.75rem; color: var(--primary); margin-bottom: 1.5rem;">All Bookings</h2>
        <div id="bookingsTable" style="overflow-x: auto;">
          <div style="text-align: center; padding: 2rem;">
            <div style="width: 50px; height: 50px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
            <p style="margin-top: 1rem; color: var(--muted-foreground);">Loading bookings...</p>
          </div>
        </div>
      </div>

      <!-- Payments Table -->
      <div id="paymentsTab" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.75rem; color: var(--primary); margin: 0;">All Payments</h2>
          <select id="paymentStatusFilter" style="padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: 4px; background: var(--background); color: var(--foreground);">
            <option value="">All Payments</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="completed">Completed</option>
            <option value="failed">Failed</option>
          </select>
        </div>
        <div id="paymentsTable" style="overflow-x: auto;">
          <div style="text-align: center; padding: 2rem;">
            <div style="width: 50px; height: 50px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
            <p style="margin-top: 1rem; color: var(--muted-foreground);">Loading payments...</p>
          </div>
        </div>
      </div>

      <!-- Testimonials Table -->
      <div id="testimonialsTab" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.75rem; color: var(--primary); margin: 0;">All Testimonials</h2>
          <select id="testimonialStatusFilter" style="padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: 4px; background: var(--background); color: var(--foreground);">
            <option value="">All Testimonials</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
        </div>
        <div id="testimonialsTable" style="overflow-x: auto;">
          <div style="text-align: center; padding: 2rem;">
            <div style="width: 50px; height: 50px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
            <p style="margin-top: 1rem; color: var(--muted-foreground);">Loading testimonials...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 1rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

th {
  background: var(--muted);
  font-weight: 600;
  color: var(--foreground);
}

tr:hover {
  background: var(--muted);
}

.status-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.85rem;
  font-weight: 500;
  display: inline-block;
}

.status-pending {
  background: #fef3c7;
  color: #92400e;
}

.status-approved {
  background: #d1fae5;
  color: #065f46;
}

.status-rejected {
  background: #fee2e2;
  color: #991b1b;
}

.status-cancelled {
  background: #e5e7eb;
  color: #374151;
}

.status-completed {
  background: #dbeafe;
  color: #1e40af;
}

.status-approved {
  background: #d1fae5;
  color: #065f46;
}

.btn-group {
  display: flex;
  gap: 0.5rem;
}

.btn-small {
  padding: 0.375rem 0.75rem;
  font-size: 0.875rem;
  border-radius: 4px;
  border: none;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-approve {
  background: #10b981;
  color: white;
}

.btn-approve:hover {
  background: #059669;
}

.btn-reject {
  background: #ef4444;
  color: white;
}

.btn-reject:hover {
  background: #dc2626;
}

.tab-btn.active {
  background: var(--primary) !important;
  color: white !important;
}

.tab-btn {
  transition: all 0.2s;
}

.tab-btn:hover {
  background: var(--muted) !important;
}
</style>

<script src="/js/admin.js"></script>
<script>
// Tab switching functions
function showBookingsTab() {
  document.getElementById('bookingsTab').style.display = 'block';
  document.getElementById('paymentsTab').style.display = 'none';
  document.getElementById('bookingsTabBtn').classList.add('active');
  document.getElementById('paymentsTabBtn').classList.remove('active');
}

function showPaymentsTab() {
  document.getElementById('bookingsTab').style.display = 'none';
  document.getElementById('paymentsTab').style.display = 'block';
  document.getElementById('bookingsTabBtn').classList.remove('active');
  document.getElementById('paymentsTabBtn').classList.add('active');
  loadPayments();
}
</script>

