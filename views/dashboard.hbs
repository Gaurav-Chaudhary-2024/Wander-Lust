<div class="container" style="padding: 4rem 1rem; min-height: 70vh;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <h1 style="font-size: 2.5rem; color: var(--primary); margin-bottom: 0.5rem;">My Dashboard</h1>
    <p style="color: var(--muted-foreground); margin-bottom: 3rem;">Welcome back, {{user.name}}!</p>

    {{#if (eq user.role "admin")}}
    <div style="background: linear-gradient(135deg, #1B263B 0%, #D4AF37 100%); color: white; padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 2rem;">
      <h2 style="margin: 0 0 0.5rem 0;">👑 Admin Access</h2>
      <p style="margin: 0 0 1rem 0; opacity: 0.9;">You have administrative privileges</p>
      <a href="/admin" class="btn" style="background: white; color: #1B263B; text-decoration: none; display: inline-block;">Go to Admin Panel</a>
    </div>
    {{/if}}

    <!-- Profile Picture Upload -->
    <div style="background: var(--card); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border); margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem; color: var(--primary); margin-bottom: 1rem;">Profile Picture</h2>
      <div style="display: flex; align-items: center; gap: 2rem;">
        <div id="profilePictureContainer" style="width: 120px; height: 120px; border-radius: 50%; background: var(--muted); display: flex; align-items: center; justify-content: center; overflow: hidden;">
          <img id="profilePicture" src="{{user.profilePicture}}" alt="Profile" style="width: 100%; height: 100%; object-fit: cover; display: none;">
          <span id="profileInitials" style="font-size: 2.5rem; color: var(--primary); font-weight: bold;">{{substring user.name 0 1}}{{uppercase (substring user.name 1 2)}}</span>
        </div>
        <div>
          <input type="file" id="profilePictureInput" accept="image/*" style="display: none;" onchange="handleProfilePictureUpload(event)">
          <button onclick="document.getElementById('profilePictureInput').click()" class="btn btn-primary">Upload Picture</button>
          <p style="color: var(--muted-foreground); font-size: 0.875rem; margin-top: 0.5rem;">JPG, PNG, or WebP (max 5MB)</p>
        </div>
      </div>
    </div>

    <!-- Recommendations Section -->
    <div id="recommendationsSection" style="background: var(--card); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border); margin-bottom: 2rem; display: none;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.75rem; color: var(--primary); margin: 0;">✨ Personalized Recommendations</h2>
        <button onclick="showPreferencesModal()" class="btn btn-outline" style="padding: 0.5rem 1rem;">Edit Preferences</button>
      </div>
      <div id="recommendationsContainer" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
        <!-- Recommendations will be loaded here -->
      </div>
    </div>

    <!-- Notifications Section -->
    <div style="background: var(--card); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border); margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.75rem; color: var(--primary); margin: 0;">Notifications</h2>
        <button onclick="showAllNotifications()" class="btn btn-outline" style="padding: 0.5rem 1rem;">View All</button>
      </div>
      <div id="notificationsList" style="max-height: 300px; overflow-y: auto;">
        <!-- Notifications will be loaded via JavaScript -->
      </div>
    </div>

    <!-- Bookings Section -->
    <div style="background: var(--card); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border); margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem; color: var(--primary); margin-bottom: 1.5rem;">My Bookings</h2>
      <div id="bookingsContainer">
        <div id="bookingsList" style="text-align: center; padding: 2rem;">
          <div style="width: 50px; height: 50px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
          <p style="margin-top: 1rem; color: var(--muted-foreground);">Loading bookings...</p>
        </div>
      </div>
    </div>

    <!-- Payment History -->
    <div style="background: var(--card); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border);">
      <h2 style="font-size: 1.75rem; color: var(--primary); margin-bottom: 1.5rem;">Payment History</h2>
      <div id="paymentsContainer">
        <div style="text-align: center; padding: 2rem;">
          <div style="width: 50px; height: 50px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
          <p style="margin-top: 1rem; color: var(--muted-foreground);">Loading payments...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>

<script>
// Handle profile picture upload
async function handleProfilePictureUpload(event) {
  const file = event.target.files[0];
  if (!file) return;

  // Validate file size (5MB)
  if (file.size > 5 * 1024 * 1024) {
    alert("File size must be less than 5MB");
    return;
  }

  // Validate file type
  if (!file.type.startsWith('image/')) {
    alert("Please select an image file");
    return;
  }

  try {
    const formData = new FormData();
    formData.append('profilePicture', file);

    const response = await fetch('/api/upload/profile-picture', {
      method: 'POST',
      body: formData,
      credentials: 'same-origin'
    });

    const result = await response.json();

    if (result.success) {
      // Update profile picture display
      const img = document.getElementById('profilePicture');
      const initials = document.getElementById('profileInitials');
      img.src = result.imageUrl + '?t=' + Date.now(); // Cache bust
      img.style.display = 'block';
      initials.style.display = 'none';
      alert('Profile picture uploaded successfully!');
    } else {
      alert(result.message || 'Failed to upload profile picture');
    }
  } catch (error) {
    console.error('Upload error:', error);
    alert('Failed to upload profile picture');
  }
}

// Load recommendations
async function loadRecommendations() {
  try {
    const result = await getRecommendations();
    if (result && result.success && result.recommendations && result.recommendations.length > 0) {
      const section = document.getElementById('recommendationsSection');
      const container = document.getElementById('recommendationsContainer');
      section.style.display = 'block';
      renderRecommendations(result.recommendations, 'recommendationsContainer');
    }
  } catch (error) {
    console.error('Failed to load recommendations:', error);
  }
}

// Load recommendations on page load
document.addEventListener('DOMContentLoaded', () => {
  loadRecommendations();
});
</script>

<!-- Include personalization script -->
<script src="/js/personalization.js"></script>
