 <!-- Hero Section -->
  <section class="contact-hero">
    <div class="container">
      <div class="contact-hero-grid">
        <div class="contact-hero-content">
          <h1 class="contact-hero-title">Need Assistance?<br>We're Here to Help!</h1>
          <p class="contact-hero-description">
            Our dedicated support team is ready to answer your questions 
            and provide you with best-in-class travel experience. Reach us 
            anytime, anywhere.
          </p>
          <button class="btn btn-primary btn-lg" onclick="document.getElementById('contactForm').scrollIntoView({behavior: 'smooth'})">
            <span>📧</span>
            <span>Contact Now</span>
          </button>
        </div>
        <div class="contact-hero-image">
          <img src="https://images.unsplash.com/photo-1738082956220-a1f20a8632ce?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxuZXR3b3JrJTIwY29ubmVjdGlvbiUyMGRvdHN8ZW58MXx8fHwxNzYxNzE4ODAwfDA&ixlib=rb-4.1.0&q=80&w=1080" alt="Network Connection" class="hero-network-image">
        </div>
      </div>
    </div>
  </section>

  <!-- 24/7 Support Hotline -->
  <section class="support-hotline">
    <div class="container">
      <div class="hotline-content">
        <div class="hotline-icon">📞</div>
        <h2 class="hotline-title">24/7 Support Hotline</h2>
        <a href="tel:+18005550199" class="hotline-number">+1 (800) 555-0199</a>
        <button class="btn btn-outline btn-hotline">
          <span>💬</span>
          <span>Start Live Chat</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Contact Grid Section -->
  <section class="contact-main-section">
    <div class="container">
      <div class="contact-main-grid">
        
        <!-- Get in Touch -->
        <div class="get-in-touch">
          <h2 class="contact-section-title">Get in Touch</h2>
          
          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="contact-detail-text">
              <p><strong>123 Adventure Lane</strong></p>
              <p>WanderLust City, WL 54321</p>
              <p>United States</p>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="contact-detail-text">
              <p><strong>+1 (555) 123-4567</strong></p>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="contact-detail-text">
              <p><strong>support@wanderlust.com</strong></p>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="contact-detail-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="contact-detail-text">
              <p><strong>Support Hours</strong></p>
              <p>Monday - Friday: 9:00 AM - 9:00 PM EST</p>
              <p>Saturday - Sunday: 10:00 AM - 6:00 PM EST</p>
              <p><em>Emergency support available 24/7</em></p>
            </div>
          </div>
        </div>

        <!-- Send Us a Message -->
        <div class="send-message">
          <h2 class="contact-section-title">Send Us a Message</h2>
          
          <form id="contactForm" class="contact-form-main">
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" class="form-input" placeholder="Your full name" required>
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" class="form-input" placeholder="your.email@example.com" required>
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <input type="text" id="subject" class="form-input" placeholder="How can we help you?" required>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Type your message here...</label>
              <textarea id="message" class="form-textarea" rows="6" placeholder="Tell us more about your inquiry..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
              <span>✉️</span>
              <span>Submit Message</span>
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- Our Global Headquarters -->
